<Window x:Class="LINQLibraryExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LINQLibraryExplorer"
        mc:Ignorable="d"
        Title="LINQ Library Explorer" Height="500" Width="800"
        Background="#F0F0F0">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Filters -->
            <RowDefinition Height="Auto"/>
            <!-- Operations -->
            <RowDefinition Height="Auto"/>
            <!-- Button -->
            <RowDefinition Height="*"/>
            <!-- Results -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Author ComboBox -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
            <TextBlock Text="Author:" FontWeight="Bold"/>
            <ComboBox x:Name="AuthorComboBox"
                      Height="30"
                      FontSize="12"
                      Padding="6,2"
                      SelectionChanged="AuthorComboBox_SelectionChanged">
                <ComboBoxItem Content="All Authors" IsSelected="True"/>
            </ComboBox>
        </StackPanel>

        <!-- Genre ComboBox -->
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
            <TextBlock Text="Genre:" FontWeight="Bold"/>
            <ComboBox x:Name="GenreComboBox"
                      Height="30"
                      FontSize="12"
                      Padding="6,2"
                      SelectionChanged="GenreComboBox_SelectionChanged">
                <ComboBoxItem Content="All Genres" IsSelected="True"/>
            </ComboBox>
        </StackPanel>

        <!-- Price Range -->
        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="5">
            <StackPanel>
                <TextBlock Text="Min Price:" FontWeight="Bold"/>
                <TextBox x:Name="MinPriceTextBox" Width="80" Height="25" Text="0" TextChanged="MinPriceTextBox_TextChanged"/>
            </StackPanel>
            <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Max Price:" FontWeight="Bold"/>
                <TextBox x:Name="MaxPriceTextBox" Width="80" Height="25" Text="100" TextChanged="MaxPriceTextBox_TextChanged"/>
            </StackPanel>
        </StackPanel>

        <!-- Multiple Operations -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="5">
            <TextBlock Text="Select Operations:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox x:Name="OperationsListBox"
                     SelectionMode="Multiple"
                     Height="83"
                     Background="White"
                     BorderBrush="#B0B0B0"
                     BorderThickness="1">
                <ListBoxItem Content="Top 5 Expensive"/>
                <ListBoxItem Content="Top 5 Modern"/>
                <ListBoxItem Content="Average Price"/>
                <ListBoxItem Content="Group by Author"/>
            </ListBox>
        </StackPanel>

        <!-- Run Query Button -->
        <Button Grid.Row="2" Grid.Column="2" Content="Run Query" Height="30" Width="120" Margin="74,5,29,5"
                Click="RunQuery_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>

        <!-- Result TextBox -->
        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                 x:Name="resultWindow"
                 Margin="5"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 Background="White"
                 Padding="8"
                 Text="Results will appear here..."
                 IsReadOnly="True"/>
    </Grid>
</Window>
